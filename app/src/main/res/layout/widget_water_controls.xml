<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_hot_water"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_hot"
        android:contentDescription="@string/widget_hot_water"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/widget_hot_water"
        android:textColor="#8A1C13"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_cold_water"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_cold"
        android:contentDescription="@string/widget_cold_water"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/widget_cold_water"
        android:textColor="#15528A"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_temporary_scan"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_scan"
        android:contentDescription="@string/widget_temporary_scan"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/widget_temporary_scan"
        android:textColor="#344255"
        android:textSize="15sp" />

</LinearLayout>
